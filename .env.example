# CRYVEX SHOPFLOW VOICE AI ENVIRONMENT CONFIGURATION
# Copy to .env for local development

# Runtime Environment
ENVIRONMENT=development
DEBUG=true

# Service-to-Service Authentication
# Min 32 random characters recommended for production
SERVICE_API_KEY=replace-with-a-secure-random-service-key-32chars

# Catalogue Integration
# Options: 'mock' (local testing) or 'http' (connects to authoritative ShopFlow main backend)
CATALOGUE_PROVIDER_TYPE=mock
SHOPFLOW_BACKEND_URL=http://localhost:8000
SHOPFLOW_INTERNAL_API_KEY=replace-with-shopflow-internal-api-key
CATALOGUE_TIMEOUT_SECONDS=3.0
CATALOGUE_CACHE_TTL_SECONDS=60

# Speech Recognition Model & Lifecycle
# Options: 'mock' or 'offline_conformer'
SPEECH_PROVIDER_TYPE=mock
SPEECH_MODEL_NAME=mock-speech-v1
SPEECH_MODEL_WARMUP_ON_STARTUP=true
MAX_AUDIO_SIZE_BYTES=5242880
MAX_AUDIO_DURATION_SECONDS=30.0
INFERENCE_TIMEOUT_SECONDS=8.0

# Retail Safety Thresholds
DEFAULT_MAX_QUANTITY=500.0
MAX_DECIMAL_PLACES=3
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60
FUZZY_DISCOVERY_THRESHOLD=75.0

# Conversation and Idempotency
CONVERSATION_SESSION_TTL_SECONDS=600
IDEMPOTENCY_CACHE_SIZE=2000

# Optional Database (Not authoritative for billing or products)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shopflow_voice

